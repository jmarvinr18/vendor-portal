# Copy to .env.development.local (git-ignored) and fill in.

# Base URL the browser calls. Keep the default to go through the Vite dev proxy (and the
# nginx proxy in the Docker image), which avoids CORS entirely.
VITE_APP_API_URL=/api/v1

# Where the Vite dev server forwards /api requests (the Flask API).
API_PROXY_TARGET=http://localhost:8000

# Development only, until real authentication exists: sent as X-Vendor-Id.
# Get it from `docker compose exec api flask seed-demo` in vendor-portal-api, or leave it
# empty and set DEFAULT_VENDOR_ID on the API instead. Never set this for production builds —
# VITE_ variables are embedded in the JavaScript bundle.
VITE_VENDOR_ID=
